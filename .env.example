# Telegram userbot (продавец) — my.telegram.org
TG_API_ID=
TG_API_HASH=
TG_PHONE=
TG_STRING_SESSION=

# Бот-хэндофф (BotFather)
BOT_TOKEN=
BOT_USERNAME=og1_priemnaya_bot

# LLM (Anthropic)
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5

# Хранение
DB_PATH=og1_leads.db

# Оператор (chat_id для карточек эскалации/блокировки)
OPERATOR_CHAT=

# CRM — логин/пароль в БД (см. manage_users.py), CRM_SECRET_KEY подписывает cookie-сессию
# (сгенерировать: python -c "import secrets; print(secrets.token_hex(32))")
CRM_SECRET_KEY=change-me
CRM_HOST=127.0.0.1
CRM_PORT=8080

# Безопасные дефолты — включать осознанно после ручной обкатки
DRY_RUN=1
SCHEDULER_ENABLED=0

# Группы
GROUP_REPLY_MODE=off

# lead-catcher-auto — ОТДЕЛЬНЫЕ аккаунты от боевого userbot'а продаж
CATCHER_TG_API_ID=
CATCHER_TG_API_HASH=
CATCHER_TG_PHONE=
CATCHER_TG_STRING_SESSION=
VK_APP_ID=
VK_ACCESS_TOKEN=

# ТГ-агент оператора — отдельный бот (BotFather); AGENT_ALLOWED_IDS — Telegram-ID через запятую
AGENT_BOT_TOKEN=
AGENT_ALLOWED_IDS=
AGENT_MODEL=claude-sonnet-5

# Google Docs для отчётов агента: путь к JSON-ключу сервисного аккаунта,
# e-mail'ы через запятую, кому открывать документы, и (необязательно) папка на Диске
GOOGLE_OAUTH_CLIENT_FILE=
GOOGLE_OAUTH_TOKEN_FILE=secrets/google-token.json
GOOGLE_SERVICE_ACCOUNT_FILE=
GOOGLE_SHARE_EMAILS=
GOOGLE_DRIVE_FOLDER_ID=

# Бот-кассир выключен: горячий лид доводится до звонка специалиста. 1 — вернуть кассира.
CASHIER_BOT_ENABLED=0
# Кому бот BOT_USERNAME шлёт карточки готовых лидов (Telegram-ID через запятую; по умолчанию AGENT_ALLOWED_IDS)
READY_LEADS_CHAT_IDS=

# Чем ловец разбирает чаты: claude_code — Claude Code CLI по подписке (claude -p), api — ANTHROPIC_API_KEY
CATCHER_LLM_BACKEND=claude_code
CLAUDE_BIN=

# Megabitra (AlterCPA): отправка готовых лидов, см. megabitra.py.
# MEGABITRA_LEAD_IP=auto — внешний IP этого компьютера; MEGABITRA_NO_PHONE — заглушка, если лид без телефона
MEGABITRA_API_KEY=
MEGABITRA_OFFER=
MEGABITRA_FLOW=
MEGABITRA_LEAD_IP=auto
MEGABITRA_NO_PHONE=
MEGABITRA_COUNTRY=
