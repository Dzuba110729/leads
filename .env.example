# Telegram userbot (продавец) — my.telegram.org
TG_API_ID=
TG_API_HASH=
TG_PHONE=
TG_STRING_SESSION=

# Бот-хэндофф (BotFather)
BOT_TOKEN=
BOT_USERNAME=og1_priemnaya_bot

# LLM (Anthropic)
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5

# Хранение
DB_PATH=og1_leads.db

# Оператор (chat_id для карточек эскалации/блокировки)
OPERATOR_CHAT=

# CRM — логин/пароль в БД (см. manage_users.py), CRM_SECRET_KEY подписывает cookie-сессию
# (сгенерировать: python -c "import secrets; print(secrets.token_hex(32))")
CRM_SECRET_KEY=change-me
CRM_HOST=127.0.0.1
CRM_PORT=8080

# Безопасные дефолты — включать осознанно после ручной обкатки
DRY_RUN=1
SCHEDULER_ENABLED=0

# Группы
GROUP_REPLY_MODE=off

# lead-catcher-auto — ОТДЕЛЬНЫЕ аккаунты от боевого userbot'а продаж
CATCHER_TG_API_ID=
CATCHER_TG_API_HASH=
CATCHER_TG_PHONE=
CATCHER_TG_STRING_SESSION=
VK_APP_ID=
VK_ACCESS_TOKEN=
